// ============================================================
// فهرست‌بارگذاری (IndexUploader) – نسخه متن ساده
// بارگذاری متن از فایل‌های محلی بدون هیچ برچسب اضافی
// ============================================================

(function() {
    'use strict';

    // ---- Configuration ----
    const CONFIG = {
        DELAY_MS: 500,
        TOOL_NAME: 'فهرست‌بارگذاری',
        EDIT_SUMMARY: 'بهبود قالب‌بندی با استفاده از مدل minimax/minimax-m3',
        FILE_PATTERN: (num) => `${num}_out.txt`,
    };

    // ---- Utilities ----
    function toPersianDigits(num) {
        const map = {'0':'۰','1':'۱','2':'۲','3':'۳','4':'۴','5':'۵','6':'۶','7':'۷','8':'۸','9':'۹'};
        return String(num).replace(/\d/g, d => map[d]);
    }

    // ---- DOM Helpers ----
    function createProgressDiv() {
        const div = document.createElement('div');
        div.id = 'indexUploaderProgress';
        div.style.cssText = [
            'margin: 10px 0',
            'padding: 8px 12px',
            'background: #f8f9fa',
            'border: 1px solid #dee2e6',
            'border-radius: 4px',
            'font-size: 13px',
            'font-family: sans-serif',
            'color: #212529',
            'display: none'
        ].join(';');
        return div;
    }

    function updateProgress(div, message, isError = false, isComplete = false) {
        if (!div) return;
        div.style.display = 'block';
        div.textContent = message;
        if (isError) {
            div.style.background = '#f8d7da';
            div.style.borderColor = '#f5c6cb';
            div.style.color = '#721c24';
        } else if (isComplete) {
            div.style.background = '#d4edda';
            div.style.borderColor = '#c3e6cb';
            div.style.color = '#155724';
        } else {
            div.style.background = '#f8f9fa';
            div.style.borderColor = '#dee2e6';
            div.style.color = '#212529';
        }
    }

    // ---- Core Functions ----
    async function getIndexWikitext(indexTitle) {
        const url = `https://fa.wikisource.org/w/api.php?action=parse&page=${encodeURIComponent(indexTitle)}&prop=wikitext&format=json`;
        const res = await fetch(url);
        const data = await res.json();
        return data.parse.wikitext['*'];
    }

    // ---- Extract total page count from PDF ----
    async function getPdfPageCount(fileName) {
        const url = `https://fa.wikisource.org/w/api.php?action=query&titles=File:${encodeURIComponent(fileName)}&prop=imageinfo&iiprop=metadata&format=json`;
        const res = await fetch(url);
        const data = await res.json();
        const pages = data.query.pages;
        for (const pid in pages) {
            const info = pages[pid].imageinfo;
            if (info && info[0] && info[0].metadata) {
                for (const meta of info[0].metadata) {
                    if (meta.name === 'Pages') return parseInt(meta.value, 10);
                }
            }
        }
        return null;
    }

    // ---- API: Get CSRF token ----
    async function getCsrfToken() {
        const url = 'https://fa.wikisource.org/w/api.php?action=query&meta=tokens&format=json';
        const res = await fetch(url);
        const data = await res.json();
        return data.query.tokens.csrftoken;
    }

    // ---- API: Create/Update page with plain text ----
    async function createPage(title, content, summary) {
        const token = await getCsrfToken();
        const form = new FormData();
        form.append('action', 'edit');
        form.append('title', title);
        form.append('text', content);
        form.append('summary', summary);
        form.append('token', token);
        form.append('format', 'json');
        const res = await fetch('https://fa.wikisource.org/w/api.php', { method: 'POST', body: form });
        const data = await res.json();
        if (data.edit && data.edit.result === 'Success') return true;
        throw new Error('Edit failed: ' + JSON.stringify(data));
    }

    // ---- Main function ----
    async function uploadFromLocal(dirHandle) {
        const indexTitle = mw.config.get('wgPageName');
        if (!indexTitle.startsWith('فهرست:')) {
            alert('این صفحه یک فهرست نیست.');
            return;
        }

        const container = document.querySelector('#mw-content-text');
        let progressDiv = document.getElementById('indexUploaderProgress');
        if (!progressDiv) {
            progressDiv = createProgressDiv();
            if (container) container.prepend(progressDiv);
        }
        updateProgress(progressDiv, '⏳ در حال آماده‌سازی...');

        try {
            const fileName = indexTitle.replace('فهرست:', '');
            let total = await getPdfPageCount(fileName);
            if (!total) {
                const input = prompt('تعداد صفحات PDF پیدا نشد. لطفاً به‌صورت دستی وارد کنید:', '');
                total = parseInt(input, 10);
                if (isNaN(total) || total < 1) {
                    updateProgress(progressDiv, '❌ تعداد صفحات نامعتبر است.', true);
                    return;
                }
            }
            console.log(`📄 Total pages: ${total}`);

            // List files in the selected folder
            let entries = [];
            try {
                for await (const entry of dirHandle.values()) {
                    entries.push(entry);
                }
            } catch (err) {
                console.warn('Could not list folder contents:', err);
            }
            const fileNames = new Set();
            for (const entry of entries) {
                if (entry.kind === 'file') {
                    fileNames.add(entry.name);
                }
            }
            console.log(`📂 Found ${fileNames.size} files.`);

            let successCount = 0;
            let errorCount = 0;
            let skippedCount = 0;

            for (let scan = 1; scan <= total; scan++) {
                const fileNamePattern = CONFIG.FILE_PATTERN(scan);
                updateProgress(progressDiv, `⏳ صفحه ${scan} / ${total} — فایل: ${fileNamePattern}`);
                console.log(`📄 Page ${scan} - looking for ${fileNamePattern}`);

                if (!fileNames.has(fileNamePattern)) {
                    console.log(`   ⏭️ فایل ${fileNamePattern} وجود ندارد، رد می‌شود.`);
                    skippedCount++;
                    continue;
                }

                // Read file
                let fileHandle;
                try {
                    fileHandle = await dirHandle.getFileHandle(fileNamePattern);
                } catch (err) {
                    console.error(`   ❌ خطا در دریافت فایل: ${err.message}`);
                    errorCount++;
                    continue;
                }
                const file = await fileHandle.getFile();
                const content = await file.text();

                if (!content || content.trim().length === 0) {
                    console.log(`   ⚠️ فایل خالی است.`);
                }

                // Build page title (with Persian digits)
                const base = indexTitle.replace('فهرست:', '');
                const scanPersian = toPersianDigits(scan);
                const pageTitle = `برگه:${base}/${scanPersian}`;

                // ---- SAVE ONLY THE RAW TEXT (no tags, no markup) ----
                const wikitextContent = content; // just the plain text from the file

                try {
                    await createPage(pageTitle, wikitextContent, CONFIG.EDIT_SUMMARY);
                    console.log(`   ✅ صفحه ${scan} با موفقیت بارگذاری شد.`);
                    successCount++;
                } catch (err) {
                    console.error(`   ❌ خطا در بارگذاری صفحه ${scan}:`, err.message);
                    errorCount++;
                }

                if (scan < total) {
                    await new Promise(r => setTimeout(r, CONFIG.DELAY_MS));
                }
            }

            const finalMsg = `✅ عملیات تمام شد. ${successCount} صفحه بارگذاری شد، ${errorCount} خطا، ${skippedCount} صفحه فایل نداشتند.`;
            console.log(finalMsg);
            updateProgress(progressDiv, finalMsg, false, true);

        } catch (err) {
            console.error('❌ خطای کلی:', err);
            updateProgress(progressDiv, `❌ خطا: ${err.message}`, true);
        }
    }

    // ---- Add Button ----
    function addButton() {
        const pageName = mw.config.get('wgPageName');
        if (!pageName.startsWith('فهرست:')) return;

        const container = document.querySelector('#mw-content-text');
        if (!container) return;

        if (document.getElementById('indexUploaderButton')) return;

        const btn = document.createElement('button');
        btn.id = 'indexUploaderButton';
        btn.textContent = '📤 بارگذاری متن از فایل‌های محلی';
        btn.style.cssText = [
            'margin: 5px 0',
            'padding: 4px 10px',
            'background: #17a2b8',
            'color: white',
            'border: none',
            'border-radius: 3px',
            'cursor: pointer',
            'font-size: 13px',
            'font-weight: bold',
            'font-family: sans-serif'
        ].join(';');

        btn.addEventListener('click', async function() {
            this.disabled = true;
            this.textContent = '⏳ انتخاب پوشه...';

            let dirHandle;
            try {
                dirHandle = await window.showDirectoryPicker();
                console.log(`📂 Selected folder: ${dirHandle.name}`);
            } catch (err) {
                if (err.name === 'AbortError' || err.message.includes('abort')) {
                    alert('انتخاب پوشه لغو شد.');
                } else {
                    alert('خطا در انتخاب پوشه: ' + err.message);
                }
                this.disabled = false;
                this.textContent = '📤 بارگذاری متن از فایل‌های محلی';
                return;
            }

            // Test read permission
            try {
                for await (const entry of dirHandle.values()) {
                    break;
                }
            } catch (err) {
                alert('خطا: دسترسی خواندن به این پوشه وجود ندارد. لطفاً پوشه دیگری را انتخاب کنید.');
                this.disabled = false;
                this.textContent = '📤 بارگذاری متن از فایل‌های محلی';
                return;
            }

            this.textContent = '⏳ در حال بارگذاری...';
            await uploadFromLocal(dirHandle);
            this.disabled = false;
            this.textContent = '📤 بارگذاری متن از فایل‌های محلی';
        });

        container.prepend(btn);
    }

    // ---- Initialize ----
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', addButton);
    } else {
        addButton();
    }
})();
